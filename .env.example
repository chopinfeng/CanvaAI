# ---- Agent / DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---- Vision 兜底（可选，任意 OpenAI 兼容 VLM）----
# 没配的话 canvas_snapshot 会被自动摘掉——留着只会让模型反复调一个读不出内容的工具。
# 位图上的标注位置仍能算出来（canvas_describe 的 onImages），不受影响。
#
# 火山方舟示例（需先在控制台「开通管理」里开通对应模型，否则报 ModelNotOpen）：
#   VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   VLM_API_KEY=<你的 ARK API KEY>
#   VLM_MODEL=doubao-seed-2-0-pro-260215
#
# 方舟 Agent Plan 是另一套：base 是 /api/plan、走 Anthropic 协议、
# 且需要 Agent Plan 专属 API Key（普通方舟 Key 在那儿会 401）：
#   VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
#   VLM_PROTOCOL=anthropic
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
# openai | anthropic；留空按 base URL 自动判断
VLM_PROTOCOL=

# ---- 语音（M4）----
ASR_PROVIDER=none          # none | whispercpp | funasr | openai
ASR_BASE_URL=
ASR_API_KEY=
TTS_PROVIDER=none          # none | edge | openai
TTS_BASE_URL=
TTS_API_KEY=

# ---- 数学 sidecar ----
MATH_SIDECAR_URL=http://127.0.0.1:8787

# ---- 服务 ----
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATA_DIR=./data
LOG_LEVEL=info
