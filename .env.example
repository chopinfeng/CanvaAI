# ---- Agent / DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---- Vision 兜底（可选，任意 OpenAI 兼容 VLM）----
# 没配的话 canvas_snapshot 会被自动摘掉——留着只会让模型反复调一个读不出内容的工具。
# 位图上的标注位置仍能算出来（canvas_describe 的 onImages），不受影响。
#
# Kimi K3（推荐：原生视觉、OpenAI 兼容，协议自动识别）：
#   VLM_BASE_URL=https://api.moonshot.ai/v1
#   VLM_API_KEY=<你的 Moonshot API Key>
#   VLM_MODEL=kimi-k3
#
# 火山方舟示例（需先在控制台「开通管理」里开通对应模型，否则报 ModelNotOpen）：
#   VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   VLM_API_KEY=<你的 ARK API KEY>
#   VLM_MODEL=doubao-seed-2-0-pro-260215
#
# 方舟 Agent Plan 是另一套：base 是 /api/plan、走 Anthropic 协议、
# 且需要 Agent Plan 专属 API Key（普通方舟 Key 在那儿会 401）：
#   VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
#   VLM_PROTOCOL=anthropic
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
# openai | anthropic；留空按 base URL 自动判断
VLM_PROTOCOL=

# ---- 语音（M4）----
ASR_PROVIDER=none          # none | whispercpp | funasr | openai
ASR_BASE_URL=
ASR_API_KEY=
TTS_PROVIDER=none          # none | edge | openai
TTS_BASE_URL=
TTS_API_KEY=

# ---- 数学 sidecar ----
MATH_SIDECAR_URL=http://127.0.0.1:8787

# ---- 服务 ----
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATA_DIR=./data
LOG_LEVEL=info

# ---- 部署（本地开发都不用填）----
# 挂在站点子路径下时填，例如 /apps。要和前端构建的 WEB_BASE 对上，
# 否则页面加载不到自己的 js。
BASE_PATH=
# 前端构建产物目录。填了就由服务端自己发页面，省掉一层 nginx 转发。
WEB_DIST=

# ---- R2（只有跑在 Cloudflare Containers 上时才需要）----
# 容器磁盘是临时的，一停就抹掉。房间快照和学习记录必须存到 R2，
# 否则表现是"隔一阵回来画布空了"，而且不报错。
# 四个必须配齐，缺一个会退回本地磁盘并在日志里报 blobs.r2_incomplete。
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
